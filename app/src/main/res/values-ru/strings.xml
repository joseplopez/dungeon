    <string name="ability_white_mage_name">Вспышка Кураги</string>
    <string name="ability_white_mage_desc">Восстанавливает большое количество ОЗ всем живым союзникам каждые 3 хода.</string>

    <string name="ability_black_mage_name">Стихийная вспышка</string>
    <string name="ability_black_mage_desc">Выпускает мощную волну магии, наносящую 180%% урона всем врагам каждые 3 хода.</string>

    <string name="ability_thief_name">Теневой грабеж</string>
    <string name="ability_thief_desc">Быстро атакует цель и крадет дополнительный Магицит у врага каждые 3 хода.</string>

    <string name="ability_monk_name">Удар чакры</string>
    <string name="ability_monk_desc">Восстанавливает 35%% макс. ОЗ себе и наносит 150%% физ. урона цели каждые 3 хода.</string>

    <string name="ability_knight_name">Удар щитом</string>
    <string name="ability_knight_desc">Наносит тяжелый физ. урон 180%% самому сильному врагу. Прикрывает раненых в обычные ходы.</string>

    <string name="ability_paladin_name">Святое сияние</string>
    <string name="ability_paladin_desc">Наносит святой урон всем врагам и одновременно исцеляет всех живых союзников каждые 3 хода.</string>

    <string name="ability_red_mage_name">Двойное заклинание</string>
    <string name="ability_red_mage_desc">Кастует две магические атаки подряд за один ход каждые 3 хода.</string>

    <string name="ability_summoner_name">Призыв Эйдолона</string>
    <string name="ability_summoner_desc">Призывает Ифрита, Шиву, Раму или Бахамута, нанося огромный маг. урон всем врагам каждые 3 хода.</string>

    <string name="ability_ninja_name">Теневой разрез</string>
    <string name="ability_ninja_desc">Наносит смертоносный удар двумя клинками (220%% урона) по цели каждые 3 хода.</string>

    <string name="ability_dragoon_name">Высокий прыжок</string>
    <string name="ability_dragoon_desc">Взмывает в небо и обрушивается на врага копьем, нанося огромный урон каждые 3 хода.</string>

    <string name="ability_bard_name">Героическая песнь</string>
    <string name="ability_bard_desc">Исполняет песни (Пеон, Минне, Менуэт, Баллада), усиливая отряд или исцеляя союзников.</string>

    <string name="ability_samurai_name">Взмах Дзенинаге</string>
    <string name="ability_samurai_desc">Бросает гили с огромной силой, нанося 200%% физ. урона всем врагам каждые 3 хода.</string>

    <string name="ability_onion_knight_name">Скрытый потенциал</string>
    <string name="ability_onion_knight_desc">Получает огромные бонусы к характеристикам с ростом мастерства (+50 ОЗ за уровень).</string>

    <string name="ability_mime_name">Мимикрия</string>
    <string name="ability_mime_desc">Мгновенно копирует и повторяет последний навык союзника каждые 3 хода.</string>

    <string name="ability_necromancer_name">Иссушение души</string>
    <string name="ability_necromancer_desc">Высасывает 200%% маг. урона у врага и передает 50%% в виде исцеления отряду каждые 3 хода.</string>

    <string name="ability_blue_mage_name">Магия монстров</string>
    <string name="ability_blue_mage_desc">Использует изученную магию монстров для адаптации к бою каждые 3 хода.</string>
